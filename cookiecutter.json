{
  "package_name": "package_name",
  "repository_github_url": "https://github.com/reef-technologies/{{ cookiecutter.package_name | replace('_', '-') }}",
  "python_versions": "3.11, 3.12, 3.13, 3.14",
  "django_versions": "4.2, 5.2",
  "build_docker_image": false,
  "__prompts__": {
    "django_versions": "Make empty if not a Django package"
  },
  "_jinja2_env_vars": {
    "trim_blocks": true,
    "lstrip_blocks": true
  },
  "_extensions": ["local_extensions.sort_versions"]
}
