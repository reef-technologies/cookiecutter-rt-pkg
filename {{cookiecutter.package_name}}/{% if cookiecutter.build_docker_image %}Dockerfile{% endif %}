ARG IMAGE=python:3.14.9-slim-trixie

FROM ${IMAGE} AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libffi-dev \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# 0.13.5-python3.14-trixie
COPY --from=ghcr.io/astral-sh/uv@sha256:00c6beb41f4ceb136a7e28a48f9d7ded75f85f4e99bce30a6c89dffbd5d10d7c /usr/local/bin/uv /usr/local/bin/uvx /bin/
COPY . .

RUN mkdir -p /build && uv export --all-extras --no-emit-project --format requirements.txt > /build/requirements.txt
RUN uv build --wheel --out-dir /build

# ------------------------------

FROM ${IMAGE}
ENV PATH="/usr/local/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends \
    libffi8 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build /build
RUN pip install --no-cache-dir -r /build/requirements.txt \
    && pip install --no-cache-dir /build/*.whl \
    && rm -rf /build
ENTRYPOINT ["{{ cookiecutter.package_name | replace('_', '-') }}"]
